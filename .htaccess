RewriteEngine On

# Apple App Site Association must be served as JSON and uncompressed.
<Files "apple-app-site-association">
    Header set Content-Type "application/json"
    SetEnv no-gzip
</Files>

# Directory-style URLs (/privacy/ rather than /privacy.html).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1? [NC,L,R=301]

# ---------------------------------------------------------------- security --
# Mirrors vercel.json so the site behaves the same on either host. The two
# script hashes are the inline theme switch and the speculation rules block,
# which is why no 'unsafe-inline' is needed.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-1FMJJcf3NcHPTS/nwOOUONXpSYEEG/GemUw8TMrG74M=' 'sha256-7xJQZYhrSXoy2RpTv8KJ9cbcuCOJnf9Yia5IoLHi8zo=' 'inline-speculation-rules'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # The retired service worker has to be re-fetched to clear itself out.
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------- types --
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# ------------------------------------------------------------------ caching --
# Everything here is safe to cache hard. Fonts and screenshots are never
# edited in place, and the stylesheet and script are requested with a content
# hash in the query string, so a new build is a new URL rather than a stale
# copy someone keeps for a year.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --------------------------------------------------------------- compression --
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    # woff2 is already compressed; recompressing only costs CPU.
</IfModule>
